# Application settings
APP_NAME=Tender Ontology API
APP_VERSION=0.1.0
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000

# Database settings
DATABASE_URL=sqlite:///./tender_ontology.db

# MySQL Database (for PDF upload tasks)
MYSQL_HOST=172.16.0.116
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=tender_compliance
MYSQL_CHARSET=utf8mb4

# File Storage
FILE_STORAGE_BASE=static

# Docling settings
DOCLING_OFFLINE_MODE=true
DOCLING_DISABLE_TABLE_RECOGNITION=false
DOCLING_HIERARCHY_REFINEMENT=false

# LLM API settings (for hierarchy analysis)
DOCLING_LLM_API_KEY=your-api-key-here
DOCLING_LLM_API_BASE=https://api.openai.com/v1
DOCLING_LLM_MODEL=gpt-4o